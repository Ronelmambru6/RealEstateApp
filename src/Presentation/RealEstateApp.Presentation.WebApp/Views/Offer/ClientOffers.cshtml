@using RealEstateApp.Core.Domain.Enums
@model RealEstateApp.Core.Application.ViewModels.Offer.ClientPropertyOffersViewModel
@{
    ViewData["Title"] = $"Mis Ofertas - Propiedad {Model.PropertyCode}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Mis Ofertas Realizadas</h3>
            <p class="text-muted mb-0">
                Propiedad Código: <strong>@Model.PropertyCode</strong> | Precio Base: <strong>RD$ @Model.PropertyPrice.ToString("N0")</strong>
            </p>
        </div>
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-secondary">
            Volver a la Propiedad
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bloque para crear nueva oferta -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Realizar Nueva Oferta</h5>
            @if (Model.CanCreateOffer)
            {
                <form asp-action="Create" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.PropertyId" />
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Monto a Ofertar (RD$)</label>
                        <input type="number" name="Amount" step="1000" min="1" class="form-control" placeholder="Ej. 4500000" required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">Enviar Oferta</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning mb-0 d-flex align-items-center justify-content-between">
                    <span>⚠️ @Model.BlockReason</span>
                    <button class="btn btn-secondary" disabled>Nueva Oferta Bloqueada</button>
                </div>
            }
        </div>
    </div>

    <!-- Historial de ofertas del cliente en esta propiedad -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Monto Ofertado</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Offers.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    Aún no has realizado ofertas por esta propiedad.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var offer in Model.Offers)
                            {
                                <tr>
                                    <td>@offer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td class="fw-bold">RD$ @offer.Amount.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (offer.Status == OfferStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else if (offer.Status == OfferStatus.Accepted)
                                        {
                                            <span class="badge bg-success">Aceptada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rechazada</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>