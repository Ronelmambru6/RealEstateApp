@model List<RealEstateApp.Core.Application.ViewModels.Offer.AgentOfferClientViewModel>
@{
    ViewData["Title"] = "Clientes Ofertantes";
    int propertyId = ViewBag.PropertyId;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Clientes que han Ofertado</h3>
            <p class="text-muted mb-0">Selecciona un cliente para revisar el historial de sus ofertas y responder.</p>
        </div>
        <a asp-controller="Agent" asp-action="Index" class="btn btn-outline-secondary">Volver a Mis Propiedades</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Correo</th>
                            <th class="text-center">Total Ofertas</th>
                            <th>Última Oferta</th>
                            <th class="text-center">Estado Actual</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Esta propiedad aún no ha recibido ofertas de ningún cliente.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var client in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@client.ClientName</td>
                                    <td>@client.ClientEmail</td>
                                    <td class="text-center">@client.TotalOffersCount</td>
                                    <td>RD$ @client.LatestOfferAmount.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (client.HasPendingOffer)
                                        {
                                            <span class="badge bg-warning text-dark">Oferta Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Sin Pendientes</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="AgentClientOffers"
                                           asp-route-propertyId="@propertyId"
                                           asp-route-clientId="@client.ClientId"
                                           class="btn btn-sm btn-primary">
                                            Ver Ofertas
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>