@using RealEstateApp.Core.Domain.Enums
@model List<RealEstateApp.Core.Application.ViewModels.Offer.OfferViewModel>
@{
    ViewData["Title"] = "Ofertas del Cliente";
    int propertyId = ViewBag.PropertyId;
    string clientId = ViewBag.ClientId;
    string clientName = ViewBag.ClientName;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Historial de Ofertas: @clientName</h3>
            <p class="text-muted mb-0">Al aceptar una oferta, la propiedad pasará a estado Vendida y se rechazarán las demás pendientes.</p>
        </div>
        <a asp-action="AgentClients" asp-route-propertyId="@propertyId" class="btn btn-outline-secondary">
            Volver a Clientes Ofertantes
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Monto Ofertado</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Responder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in Model)
                        {
                            <tr>
                                <td>@offer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td class="fw-bold">RD$ @offer.Amount.ToString("N0")</td>
                                <td class="text-center">
                                    @if (offer.Status == OfferStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    else if (offer.Status == OfferStatus.Accepted)
                                    {
                                        <span class="badge bg-success">Aceptada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rechazada</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (offer.Status == OfferStatus.Pending)
                                    {
                                        <div class="d-inline-flex gap-2">
                                            <form asp-action="Respond" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Seguro que deseas ACEPTAR esta oferta? La propiedad se marcará como VENDIDA y se rechazarán las demás ofertas pendientes.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="offerId" value="@offer.Id" />
                                                <input type="hidden" name="propertyId" value="@propertyId" />
                                                <input type="hidden" name="clientId" value="@clientId" />
                                                <input type="hidden" name="accept" value="true" />
                                                <button type="submit" class="btn btn-sm btn-success">Aceptar</button>
                                            </form>

                                            <form asp-action="Respond" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Seguro que deseas RECHAZAR esta oferta?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="offerId" value="@offer.Id" />
                                                <input type="hidden" name="propertyId" value="@propertyId" />
                                                <input type="hidden" name="clientId" value="@clientId" />
                                                <input type="hidden" name="accept" value="false" />
                                                <button type="submit" class="btn btn-sm btn-danger">Rechazar</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Respondida</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>