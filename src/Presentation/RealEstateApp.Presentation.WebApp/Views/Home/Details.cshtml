@model RealEstateApp.Core.Application.ViewModels.Home.PropertyDetailViewModel
@{
    ViewData["Title"] = $"Detalle Propiedad #{Model.Code}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary fs-6 me-2">@Model.PropertyTypeName</span>
            <span class="badge bg-success fs-6">@Model.SaleTypeName</span>
            <h2 class="fw-bold mt-2">Propiedad Código: @Model.Code</h2>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al Catálogo</a>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Slider de Imágenes y Detalles -->
        <div class="col-lg-8">
            <!-- Bootstrap Carousel (Slider) -->
            @if (Model.ImageUrls.Count > 0)
            {
                <div id="propertyCarousel" class="carousel slide shadow-sm rounded overflow-hidden mb-4" data-bs-ride="carousel">
                    <div class="carousel-inner" style="height: 400px;">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "") h-100">
                                <img src="@Model.ImageUrls[i]" class="d-block w-100 h-100 object-fit-cover" alt="Foto de propiedad">
                            </div>
                        }
                    </div>
                    @if (Model.ImageUrls.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            }

            <!-- Descripción y Características -->
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold mb-3">Descripción General</h4>
                <p class="text-muted">@Model.Description</p>

                <h5 class="fw-bold mt-4 mb-3">Características</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded text-center">
                            <span class="d-block text-muted small">Habitaciones</span>
                            <span class="fs-5 fw-bold">@Model.Bedrooms</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded text-center">
                            <span class="d-block text-muted small">Baños</span>
                            <span class="fs-5 fw-bold">@Model.Bathrooms</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded text-center">
                            <span class="d-block text-muted small">Metros Cuadrados</span>
                            <span class="fs-5 fw-bold">@Model.SquareMeters m²</span>
                        </div>
                    </div>
                </div>

                <!-- Mejoras -->
                @if (Model.Improvements.Count > 0)
                {
                    <h5 class="fw-bold mt-4 mb-3">Mejoras Incluidas</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var improvement in Model.Improvements)
                        {
                            <span class="badge bg-secondary px-3 py-2">✓ @improvement</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Precio y Datos del Agente -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h3 class="text-success fw-bold mb-3">RD$ @Model.Price.ToString("N0")</h3>
                <hr />
                <h5 class="fw-bold mb-3">Información del Agente</h5>
                <div class="text-center mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.AgentPhotoUrl) ? "/images/default-avatar.png" : Model.AgentPhotoUrl)"
                         class="rounded-circle shadow-sm object-fit-cover" style="width: 100px; height: 100px;" alt="Avatar del agente">
                    <h5 class="fw-bold mt-3 mb-0">@Model.AgentFirstName @Model.AgentLastName</h5>
                    <span class="text-muted small">Agente Inmobiliario</span>
                </div>
                <ul class="list-unstyled small text-muted mb-4">
                    <li class="mb-2">📧 <strong>Correo:</strong> @Model.AgentEmail</li>
                    <li class="mb-2">📞 <strong>Teléfono:</strong> @(string.IsNullOrEmpty(Model.AgentPhoneNumber) ? "No disponible" : Model.AgentPhoneNumber)</li>
                </ul>
                <a href="mailto:@Model.AgentEmail" class="btn btn-primary w-100">Contactar Agente</a>
                <a asp-controller="PublicAgent" asp-action="Properties" asp-route-id="@Model.AgentId" class="btn btn-outline-primary w-100 mt-2">Ver más propiedades del agente</a>
            </div>
        </div>
    </div>
</div>