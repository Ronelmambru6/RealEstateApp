@model RealEstateApp.Core.Application.ViewModels.Chat.ChatThreadViewModel

<div class="border rounded p-3 mb-3 bg-white" style="max-height: 320px; overflow-y: auto;">
    @if (Model.Messages.Count == 0)
    {
        <p class="text-muted small text-center mb-0">Aún no hay mensajes en esta conversación.</p>
    }
    else
    {
        @foreach (var message in Model.Messages)
        {
            <div class="d-flex mb-2 @(message.IsFromAgent ? "justify-content-start" : "justify-content-end")">
                <div class="px-3 py-2 rounded-3 @(message.IsFromAgent ? "bg-light border" : "bg-primary text-white")" style="max-width: 85%;">
                    <div class="small fw-semibold">@message.SenderName</div>
                    <div style="white-space: pre-wrap;">@message.Content</div>
                    <div class="small @(message.IsFromAgent ? "text-muted" : "text-white-50") text-end">@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</div>
                </div>
            </div>
        }
    }
</div>
