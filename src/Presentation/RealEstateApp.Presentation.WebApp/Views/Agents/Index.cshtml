@model List<RealEstateApp.Core.Application.ViewModels.Admin.AgentListItemViewModel>
@{
    ViewData["Title"] = "Listado de Agentes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Listado de Agentes</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Volver al Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Correo</th>
                            <th class="text-center">Cantidad de Propiedades</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No hay agentes registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var agent in Model)
                            {
                                <tr>
                                    <td>@agent.FirstName</td>
                                    <td>@agent.LastName</td>
                                    <td>@agent.Email</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@agent.PropertiesCount</span>
                                    </td>
                                    <td class="text-center">
                                        @if (agent.IsActive)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <form asp-action="ToggleStatus" asp-route-id="@agent.Id" method="post"
                                                  onsubmit="return confirm('¿Está seguro que desea @(agent.IsActive ? "inactivar" : "activar") a este agente?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(agent.IsActive ? "btn-warning" : "btn-success")">
                                                    @(agent.IsActive ? "Inactivar" : "Activar")
                                                </button>
                                            </form>

                                            <a asp-action="Delete" asp-route-id="@agent.Id" class="btn btn-sm btn-danger">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>