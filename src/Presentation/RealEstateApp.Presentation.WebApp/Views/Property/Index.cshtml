@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Propiedades";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Mantenimiento de Propiedades</h2>
            <p class="text-muted">Crea, edita o elimina las propiedades de tu catálogo.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Agent" asp-action="Index" class="btn btn-outline-secondary">Volver al Panel</a>
            <a asp-action="Create" class="btn btn-primary">+ Nueva Propiedad</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Imagen</th>
                            <th>Código</th>
                            <th>Tipo</th>
                            <th>Venta</th>
                            <th>Precio</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No tienes propiedades registradas.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.MainImageUrl) ? "/images/default-property.jpg" : item.MainImageUrl)"
                                             class="rounded object-fit-cover shadow-sm" style="width: 50px; height: 50px;" alt="Foto" />
                                    </td>
                                    <td class="fw-semibold">@item.Code</td>
                                    <td>@item.PropertyTypeName</td>
                                    <td>@item.SaleTypeName</td>
                                    <td>RD$ @item.Price.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                                            @(item.IsAvailable ? "Disponible" : "Vendida")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>