@model List<RealEstateApp.Core.Application.ViewModels.Admin.SystemUserViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Administradores";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Mantenimiento de Administradores</h2>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Volver al Dashboard</a>
            <a asp-action="Create" class="btn btn-primary">+ Nuevo Administrador</a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Usuario</th>
                            <th>Cédula</th>
                            <th>Correo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model)
                        {
                            var isCurrentUser = !string.IsNullOrEmpty(currentUserId) && admin.Id == currentUserId;
                            <tr>
                                <td>@admin.FirstName</td>
                                <td>@admin.LastName</td>
                                <td>@admin.UserName</td>
                                <td>@admin.Cedula</td>
                                <td>@admin.Email</td>
                                <td class="text-center">
                                    <span class="badge @(admin.IsActive ? "bg-success" : "bg-danger")">
                                        @(admin.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (isCurrentUser)
                                    {
                                        <span class="badge bg-secondary">Sesión Actual</span>
                                    }
                                    else
                                    {
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@admin.Id" class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@admin.Id" method="post"
                                                  onsubmit="return confirm('¿Está seguro que desea @(admin.IsActive ? "inactivar" : "activar") a este administrador?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(admin.IsActive ? "btn-warning" : "btn-success")">
                                                    @(admin.IsActive ? "Inactivar" : "Activar")
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>